# Required for pyannote model access.
# Create token at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: enable Whisper transcription mode (used with pyannote diarization).
WHISPER_API_KEY=
WHISPER_API_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1

# Optional model override
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
ENABLE_SOUND_SEPARATION=true

# Local ASR fallback (recommended when WHISPER_API_KEY is empty)
ENABLE_LOCAL_ASR_FALLBACK=true
LOCAL_ASR_MODEL=distil-whisper/distil-large-v3
LOCAL_ASR_CHUNK_LENGTH_SECONDS=10
LOCAL_ASR_BATCH_SIZE=2
LOCAL_ASR_NUM_BEAMS=5
# Optional: force language, e.g. en, hi, ta. Leave empty for auto.
LOCAL_ASR_LANGUAGE=

# Alignment and diarization quality tuning
SHORT_SPEAKER_THRESHOLD_SECONDS=0.3
SPEAKER_MERGE_MAX_GAP_SECONDS=0.10
ATTACH_MIN_OVERLAP_SECONDS=0.3
ATTACH_MIN_OVERLAP_RATIO=0.4
ATTACH_NEAREST_MAX_DISTANCE_SECONDS=1.2
SPARSE_TRANSCRIPT_RATIO_THRESHOLD=0.5
