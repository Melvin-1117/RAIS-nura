# Required for pyannote model access.
# Create token at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: enable AssemblyAI diarized transcript mode.
# Get key at https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Optional: enable Whisper transcription mode (used with pyannote diarization).
# OpenAI-compatible API key and endpoint.
WHISPER_API_KEY=
WHISPER_API_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-1

# Optional model override
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
